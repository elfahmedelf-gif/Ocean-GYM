generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== Admin & Auth =====

model Admin {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String // hashed (scrypt: salt:hash)
  name      String
  createdAt DateTime  @default(now())
  sessions  Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ===== Services =====

model Service {
  id          String   @id @default(cuid())
  title       String
  summary     String // سطر تعريفي قصير
  description String
  icon        String   @default("truck") // lucide icon name
  image       String?
  features    String // مفصولة بأسطر
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== Fleet =====

model FleetVehicle {
  id          String   @id @default(cuid())
  name        String
  category    String // تريلة | قلاب | صهريج ...
  description String
  image       String?
  capacity    String?
  count       Int      @default(1)
  specs       String // مفصول بأسطر
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== Verified company figures (animated counters) =====

model Stat {
  id     String  @id @default(cuid())
  value  Int
  suffix String  @default("")
  label  String
  active Boolean @default(true)
  order  Int     @default(0)
}

// ===== Testimonials =====

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  content   String
  rating    Int      @default(5)
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ===== Quote requests (public form) =====

model QuoteRequest {
  id           String   @id @default(cuid())
  name         String
  phone        String
  email        String?
  company      String?
  serviceTitle String
  origin       String?
  destination  String?
  cargo        String?
  notes        String?
  status       String   @default("new") // new | reviewing | quoted | won | archived
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ===== Shipments & client tracking =====

model Shipment {
  id              String          @id @default(cuid())
  code            String          @unique // كود التتبع RL-1024
  clientName      String
  phone           String?
  origin          String
  destination     String
  serviceType     String          @default("النقل البري الداخلي")
  weight          String?
  vehicle         String?
  status          String          @default("pending") // pending | picked_up | in_transit | out_for_delivery | delivered | cancelled
  currentLocation String?
  notes           String?
  expectedAt      DateTime?
  deliveredAt     DateTime?
  events          ShipmentEvent[]
  portalSessions  PortalSession[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  title       String
  description String?
  location    String?
  status      String? // snapshot of shipment status at event time
  createdAt   DateTime @default(now())
}

model PortalSession {
  id         String   @id @default(cuid())
  token      String   @unique
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}
